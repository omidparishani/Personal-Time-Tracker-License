generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  note      String?
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  licenses  License[]
}

model Shift {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  startWorkTime         String    @default("09:00")
  endWorkTime           String    @default("17:00")
  flexibleMinutes       Int       @default(30)
  minimumWorkMinutes    Int       @default(480)
  weeklyRequiredMinutes Int       @default(2775)
  thursdayWorking       Boolean   @default(false)
  thursdayMinutes       Int       @default(300)
  holidaysJson          String    @default("[]")
  enabled               Boolean   @default(true)
  createdAt             DateTime  @default(now())
  licenses              License[]
}

model License {
  id             String         @id @default(cuid())
  licenseKey     String         @unique
  activationCode ActivationCode @relation(fields: [codeId], references: [id])
  codeId         String
  deviceId       String
  deviceModel    String?
  deviceBrand    String?
  androidVersion String?
  appVersion     String?
  username       String?
  adminNote      String?
  active         Boolean        @default(true)
  activatedAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  disabledAt     DateTime?
  disabledReason String?

  canJira        Boolean        @default(true)
  canAttendance  Boolean        @default(true)
  canReports     Boolean        @default(true)
  canSupport     Boolean        @default(true)

  shiftId        String?
  shift          Shift?         @relation(fields: [shiftId], references: [id])

  startWorkTime  String         @default("09:00")
  endWorkTime    String         @default("17:00")
  flexibleMinutes Int           @default(30)
  minimumWorkMinutes Int        @default(480)
  weeklyRequiredMinutes Int     @default(2775)
  thursdayWorking Boolean       @default(false)
  thursdayMinutes Int           @default(300)
  holidaysJson   String         @default("[]")

  messages       ChatMessage[]  @relation("LicenseMessages")

  @@index([deviceId])
  @@index([active])
  @@index([shiftId])
  @@unique([codeId, deviceId])
}

/// پیام پشتیبانی، مستقیم بین کاربران، یا گروهی از ادمین
model ChatMessage {
  id           String   @id @default(cuid())
  licenseId    String
  license      License  @relation("LicenseMessages", fields: [licenseId], references: [id], onDelete: Cascade)
  /// user | admin
  sender       String
  body         String
  /// support | direct | broadcast
  kind         String   @default("support")
  /// برای چت مستقیم: شناسه لایسنس طرف مقابل
  peerId       String?
  readByAdmin  Boolean  @default(false)
  readByUser   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([licenseId, createdAt])
  @@index([peerId, createdAt])
  @@index([kind, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}


/// تعطیلات رسمی — از endpoint یا دستی
model OfficialHoliday {
  id        String   @id @default(cuid())
  date      String   // yyyy-MM-dd میلادی
  title     String
  source    String?  // github | manual | admin
  createdAt DateTime @default(now())

  @@unique([date])
  @@index([date])
}


/// تنظیمات اتصال به API پیشخان بازار
model BazaarConfig {
  id              Int      @id @default(1)
  packageName     String   @default("com.personal.timetracker")
  /// نام هدر احراز هویت که پیشخان می‌دهد (مثلاً X-API-Key یا CAFEBAZAAR-API-KEY)
  apiKeyHeader    String   @default("Authorization")
  apiKeyValue     String   @default("")
  baseUrl         String   @default("https://sandoghche.cafebazaar.ir")
  /// شناسه برنامه در پیشخان (در صورت نیاز)
  appId           String?
  updatedAt       DateTime @updatedAt
}

/// تاریخچه نسخه‌های منتشر/آماده‌شده برای بازار
model AppVersion {
  id            String   @id @default(cuid())
  versionCode   Int
  versionName   String
  /// ALL | armeabi-v7a | arm64-v8a
  architecture  String   @default("ALL")
  minSdk        Int      @default(26)
  targetSdk     Int      @default(34)
  /// draft | ready | uploaded | in_review | published | rejected
  status        String   @default("draft")
  changelogFa   String   @default("")
  changelogEn   String   @default("")
  /// شناسه رهانش در پیشخان (در صورت همگام‌سازی)
  releaseId     String?
  packageId     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([versionCode, architecture])
  @@index([status])
  @@index([versionCode])
}
